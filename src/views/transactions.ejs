<%- include('partials/header') %>

<%
  const stats = transactionStats || { days: 14, summary: {}, daily: [] };
  const dayOptions = statsDaysOptions || [7, 14, 30];
  const statsByDays = transactionStatsByDays || dayOptions.reduce(function(result, days) {
    result[String(days)] = Number(stats.days) === Number(days) ? stats : { days: days, summary: {}, daily: [] };
    return result;
  }, {});
%>

<main class="content-grid">
  <section class="card stats-card" data-stats-card>
    <div class="section-title">
      <div>
        <h2 data-stats-title>近 <%= stats.days %> 天统计</h2>
        <p class="muted form-hint">按积分变化汇总。</p>
      </div>
      <nav class="stats-tabs" aria-label="统计范围">
        <% dayOptions.forEach(function(days) { %>
          <a class="<%= Number(stats.days) === Number(days) ? 'active' : '' %>" href="/transactions?days=<%= days %>" data-stats-tab="<%= days %>" aria-current="<%= Number(stats.days) === Number(days) ? 'page' : 'false' %>">
            <%= days %>天
          </a>
        <% }) %>
      </nav>
    </div>

    <% dayOptions.forEach(function(days) {
      const panelStats = statsByDays[String(days)] || { days: days, summary: {}, daily: [] };
      const summary = panelStats.summary || {};
      const daily = panelStats.daily || [];
      const chartMax = Math.max.apply(null, daily.map(function(item) {
        return Math.max(Number(item.add_points) || 0, Number(item.subtract_points) || 0, Math.abs(Number(item.net_points) || 0));
      }).concat([1]));
      const isActive = Number(stats.days) === Number(days);
    %>
      <div class="stats-panel <%= isActive ? 'active' : '' %>" data-stats-panel="<%= days %>" <%= isActive ? '' : 'hidden' %>>
        <div class="stats-summary">
          <div>
            <strong>+<%= Number(summary.total_add || 0) %></strong>
            <span>加分</span>
          </div>
          <div>
            <strong>-<%= Number(summary.total_subtract || 0) %></strong>
            <span>减分</span>
          </div>
          <div>
            <strong><%= Number(summary.net_change || 0) >= 0 ? '+' : '' %><%= Number(summary.net_change || 0) %></strong>
            <span>净变化</span>
          </div>
          <div>
            <strong><%= Number(summary.transaction_count || 0) %></strong>
            <span>记录</span>
          </div>
        </div>
        <div class="stats-chart" aria-label="近 <%= days %> 天积分趋势">
          <% if (daily.length === 0) { %>
            <p class="empty">近 <%= days %> 天还没有记录。</p>
          <% } %>
          <% daily.forEach(function(item) {
            const addHeight = Math.max(4, Math.round((Number(item.add_points) || 0) / chartMax * 64));
            const subtractHeight = Math.max(4, Math.round((Number(item.subtract_points) || 0) / chartMax * 64));
            const net = Number(item.net_points) || 0;
            const dayLabel = new Date(item.day).toLocaleDateString('zh-CN', { month: 'numeric', day: 'numeric' });
          %>
            <div class="stats-day" title="<%= dayLabel %> 净变化 <%= net >= 0 ? '+' : '' %><%= net %>">
              <div class="stats-bars">
                <span class="bar add" style="height: <%= addHeight %>px"></span>
                <span class="bar subtract" style="height: <%= subtractHeight %>px"></span>
              </div>
              <span class="stats-day-label"><%= dayLabel %></span>
              <strong class="<%= net >= 0 ? 'positive' : 'negative' %>"><%= net >= 0 ? '+' : '' %><%= net %></strong>
            </div>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </section>

  <section class="card transactions-list-card">
    <div class="timeline full">
      <% if (transactions.length === 0) { %>
        <p class="empty">还没有积分记录。</p>
      <% } %>
      <% transactions.forEach(function(item) {
        const canDelete = Number(item.can_delete) === 1;
      %>
        <article
          class="timeline-item <%= canDelete ? 'deletable-transaction' : '' %>"
          <% if (canDelete) { %>
            data-deletable-transaction
            data-delete-url="/transactions/<%= item.id %>/delete"
            data-csrf-token="<%= csrfToken %>"
          <% } %>
        >
          <div class="timeline-main">
            <strong>
              <% if (item.quick_item_icon) { %><%- renderQuickIcon(item.quick_item_icon, '', 'timeline-icon') %><% } %>
              <%= item.reason %>
            </strong>
            <span>
              <%= new Date(item.created_at).toLocaleString('zh-CN', { hour12: false }) %>
              · <%= item.source === 'quick' ? '快捷项' : item.source === 'manual' ? '手动' : '校准' %>
              · 操作后 <%= item.balance_after %> 分
            </span>
          </div>
          <div class="timeline-points <%= item.points_delta >= 0 ? 'positive' : 'negative' %>">
            <%= item.points_delta >= 0 ? '+' : '' %><%= item.points_delta %>
          </div>
        </article>
      <% }) %>
    </div>
  </section>
</main>

<script src="/app-actions.js"></script>

<script>
  (() => {
    const card = document.querySelector('[data-stats-card]');
    if (!card) {
      return;
    }
    const title = card.querySelector('[data-stats-title]');
    const tabs = Array.from(card.querySelectorAll('[data-stats-tab]'));
    const panels = Array.from(card.querySelectorAll('[data-stats-panel]'));

    function activateStats(days, href, pushUrl) {
      tabs.forEach((tab) => {
        const active = tab.dataset.statsTab === days;
        tab.classList.toggle('active', active);
        tab.setAttribute('aria-current', active ? 'page' : 'false');
      });
      panels.forEach((panel) => {
        const active = panel.dataset.statsPanel === days;
        panel.classList.toggle('active', active);
        panel.hidden = !active;
      });
      if (title) {
        title.textContent = `近 ${days} 天统计`;
      }
      if (pushUrl && href && window.history?.pushState) {
        window.history.pushState({ statsDays: days }, '', href);
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', (event) => {
        event.preventDefault();
        activateStats(tab.dataset.statsTab, tab.href, true);
      });
    });

    window.addEventListener('popstate', () => {
      const params = new URLSearchParams(window.location.search);
      const days = params.get('days') || '<%= stats.days %>';
      const tab = tabs.find((item) => item.dataset.statsTab === days) || tabs.find((item) => item.classList.contains('active'));
      if (tab) {
        activateStats(tab.dataset.statsTab, tab.href, false);
      }
    });
  })();
</script>

<%- include('partials/footer') %>
